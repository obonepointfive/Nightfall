<UserControl x:Class="Nightfall.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nightfall.UI.ViewModels"
             xmlns:models="clr-namespace:Nightfall.UI.Models"
             xmlns:conv="clr-namespace:Nightfall.UI.Converters">
    <UserControl.Resources>
        <conv:MessageAlignmentConverter x:Key="MessageAlignmentConverter" />

        <Style x:Key="MessageBubbleStyle" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Messages -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ChatMessage}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="{Binding Sender, Converter={StaticResource MessageAlignmentConverter}, ConverterParameter=Column}"
                                    Style="{StaticResource MessageBubbleStyle}"
                                    Background="{Binding IsUser, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter=User}">
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource NightForeground}"
                                           Width="380" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input bar -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="8"
                Background="#181824"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status dot -->
                <Ellipse Width="10"
                         Height="10"
                         Fill="{StaticResource AccentNeon}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />

                <!-- Text input -->
                <TextBox Grid.Column="1"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0"
                         Background="#111118"
                         Foreground="{StaticResource NightForeground}"
                         BorderBrush="#333344"
                         BorderThickness="1"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"
                         VerticalScrollBarVisibility="Auto" />

                <!-- Mic button -->
                <Button Grid.Column="2"
                        Content="🎤"
                        Margin="0,0,8,0"
                        Width="40"
                        Height="40"
                        Command="{Binding VoiceCommand}"
                        ToolTip="Voice input"
                        Background="#202030"
                        Foreground="{StaticResource AccentNeon}"
                        BorderThickness="0"
                        FontSize="18" />

                <!-- Send button -->
                <Button Grid.Column="3"
                        Content="Send"
                        Width="80"
                        Height="40"
                        Command="{Binding SendCommand}"
                        Background="{StaticResource AccentNeon}"
                        Foreground="#06060A"
                        BorderThickness="0"
                        FontWeight="Bold" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
