<Application x:Class="Nightfall.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="NightBackground" Color="#101018"/>
        <SolidColorBrush x:Key="NightForeground" Color="#F5F5FF"/>
        <SolidColorBrush x:Key="AccentNeon" Color="#5EF2FF"/>
        <SolidColorBrush x:Key="UserBubble" Color="#2A2A3A"/>
        <SolidColorBrush x:Key="AssistantBubble" Color="#171728"/>
    </Application.Resources>
</Application>
