<Window x:Class="Nightfall.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:views="clr-namespace:Nightfall.UI.Views"
        Title="Nightfall — NEON"
        WindowStyle="None"
        Background="Black"
        AllowsTransparency="True">

    <Grid>
        <!-- GPU HUD -->
        <hx:Viewport3DX x:Name="HudViewport"
                Camera="{Binding HudCamera}"
                ShowCoordinateSystem="False"
                IsHitTestVisible="False"
                EffectsManager="{Binding EffectsManager}">

            <hx:AmbientLight3D Color="#202020" />

            <hx:MeshGeometryModel3D Geometry="{Binding FullscreenQuad}"
                                    Material="{Binding HudMaterial}"
                                    IsHitTestVisible="False" />
        </hx:Viewport3DX>

        <!-- UI overlay -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="20,12,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Padding="10,4"
                            CornerRadius="4"
                            Background="#42000000"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding HudModeLabel}"
                                   Foreground="#5EF2FF"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Border Padding="10,4"
                            CornerRadius="4"
                            Background="#42000000">
                        <TextBlock Text="{Binding EmotionLabel}"
                                   Foreground="#FFC58A"
                                   FontSize="13"/>
                    </Border>
                </StackPanel>

                <ItemsControl Grid.Column="1"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding SystemMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#33000000"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="0,0,0,4">
                                <TextBlock Text="{Binding Text}"
                                           Foreground="#D0FFFFFF"
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid Grid.Row="2" Margin="40,0,40,24">
                <views:ChatView HorizontalAlignment="Center"
                                Width="900"
                                Opacity="0.94"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
