<UserControl x:Class="Nightfall.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nightfall.UI.ViewModels"
             xmlns:models="clr-namespace:Nightfall.UI.Models">

    <!-- RESOURCES -->
    <UserControl.Resources>

        <!-- Nightfall theme background -->
        <SolidColorBrush x:Key="NightBackground" Color="#0D0D12"/>

        <!-- User bubble style -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#2A2A3A"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>

        <!-- Assistant bubble -->
        <Style x:Key="AssistantBubble" TargetType="Border">
            <Setter Property="Background" Value="#171728"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>

        <!-- Boolean to Visibility converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Chat message template -->
        <DataTemplate x:Key="ChatMessageTemplate" DataType="{x:Type models:ChatMessage}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Assistant bubble left -->
                <Border Grid.Column="1"
                        Style="{StaticResource AssistantBubble}"
                        Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}">
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               Foreground="#F5F5FF"/>
                </Border>

                <!-- User bubble right -->
                <Border Grid.Column="1"
                        Style="{StaticResource UserBubble}"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               Foreground="#F5F5FF"/>
                </Border>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>


    <!-- MAIN UI LAYOUT -->
    <Grid Background="{StaticResource NightBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- MESSAGE DISPLAY AREA -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource NightBackground}">
            <ItemsControl ItemsSource="{Binding Messages}"
                          ItemTemplate="{StaticResource ChatMessageTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- INPUT AREA -->
        <Border Grid.Row="1"
                Background="#181824"
                CornerRadius="10"
                Padding="10"
                Margin="0,10,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- TEXT INPUT -->
                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#111118"
                         Foreground="White"
                         BorderBrush="#333344"
                         BorderThickness="1"
                         Padding="8"
                         Height="50"
                         VerticalContentAlignment="Center"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         Margin="0,0,10,0"/>

                <!-- MIC TOGGLE BUTTON (Option C) -->
                <ToggleButton Grid.Column="1"
                              Width="48"
                              Height="48"
                              Background="#202030"
                              Foreground="#5EF2FF"
                              BorderThickness="0"
                              FontSize="20"
                              FontWeight="Bold"
                              Cursor="Hand"
                              Content="🎤"
                              ToolTip="Click to start / click again to stop">

                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#202030"/>
                            <Setter Property="Foreground" Value="#5EF2FF"/>

                            <!-- These call code-behind handlers -->
                            <EventSetter Event="Checked" Handler="MicToggle_Checked"/>
                            <EventSetter Event="Unchecked" Handler="MicToggle_Unchecked"/>

                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#5EF2FF"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <!-- SEND BUTTON -->
                <Button Grid.Column="2"
                        Content="Send"
                        Width="80"
                        Height="48"
                        Command="{Binding SendCommand}"
                        Background="#5EF2FF"
                        Foreground="#000000"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>

</UserControl>
